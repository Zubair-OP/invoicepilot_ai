# ─── Runtime ────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Origin(s) of the frontend(s) that may call this API. Comma-separated for
# multiple origins (e.g. http://localhost:3000,https://app.yourdomain.com).
# In production this MUST be an explicit list — the server refuses to boot with
# `*` because credentials are enabled.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
BODY_SIZE_LIMIT=1mb
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=1000

# ─── Database ───────────────────────────────────────────
# Local: mongodb://localhost:27017/invoicepilot
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/invoicepilot?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/invoicepilot

# ─── Clerk Authentication ───────────────────────────────
# Get these from your Clerk Dashboard → API Keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Redis (BullMQ queues + caching) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── AI ─────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Email — Brevo ──────────────────────────────────────
# Production transactional email uses Brevo's HTTP API (port 443).
# Create an API key in Brevo and verify the sender address in Brevo.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=InvoicePilot

# ─── Google Integration ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/callback

# ─── Billing (Stripe) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Paid plans also need their stripePriceId set in
# src/modules/billing/plans.registry.ts.

# ─── Uploads ────────────────────────────────────────────
# Reserved for a future logo-upload endpoint. PDFs and email attachments are
# generated server-side, not uploaded.
MAX_FILE_SIZE_MB=10
