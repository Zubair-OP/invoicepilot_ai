# ─── Runtime ────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Origin(s) of the frontend(s) that may call this API. Comma-separated for
# multiple origins (e.g. http://localhost:3000,https://app.yourdomain.com).
# In production this MUST be an explicit list — the server refuses to boot with
# `*` because credentials are enabled (a wildcard origin + credentials is
# rejected by browsers and would let any site call the API with a stolen token).
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# JSON request body size cap. No uploads exist (PDFs are generated server-side),
# so the default fits every request.
BODY_SIZE_LIMIT=1mb
# Log requests / database commands slower than this (ms).
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=1000

# ─── Database ───────────────────────────────────────────
# Local: mongodb://localhost:27017/invoicepilot
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/invoicepilot?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/invoicepilot

# ─── Clerk Authentication ───────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
# REQUIRED: server-side only. Never expose it to a client.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPTIONAL for the backend — this is a frontend credential. Leave it unset until
# you build the Next.js app, where it becomes NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
# CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clerk Dashboard → Webhooks → add endpoint POST /webhooks/clerk → copy signing secret.
# Used in Phase 2 to keep Mongo in sync when a user is updated or deleted in Clerk.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Redis (BullMQ queues + caching) ────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── AI (Phase 4) ───────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email (Phase 6) ────────────────────────────────────
# Resend API key: https://resend.com/api-keys
# OPTIONAL — when unset, emails are logged instead of sent (safe for local/CI).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address. MUST be on a domain verified in Resend
# (https://resend.com/domains), otherwise Resend rejects the send. The display
# name is optional: `Acme <billing@acme.com>` or just `billing@acme.com`.
EMAIL_FROM=InvoicePilot <noreply@yourdomain.com>

# ─── Billing (Phase 8) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Stripe Dashboard → Developers → Webhooks → endpoint POST /webhooks/stripe
# (event types: checkout.session.completed, customer.subscription.*,
# invoice.payment_failed, payment_intent.payment_failed). Replays are idempotent.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Paid plans also need their `stripePriceId` set in
# src/modules/billing/plans.registry.ts (from Stripe → Products → Price IDs).

# ─── Uploads ────────────────────────────────────────────
# Reserved for a future logo-upload endpoint. PDFs and email attachments are
# generated server-side, not uploaded, so this does not gate any current route.
MAX_FILE_SIZE_MB=10
